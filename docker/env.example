# Copy to docker/.env (ignored by git) and fill in. Read by docker/docker-compose.yml.

# MySQL (container "mysql", database kelseydb). Reachable from the host on 127.0.0.1:MYSQL_HOST_PORT.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=kelsey
DB_PASSWORD=change-me
MYSQL_HOST_PORT=3307

# auth-service-backend: secret used to sign the JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# ai-chatbot-backend: Groq key (https://console.groq.com). Leave empty to run without the chat.
GROQ_API_KEY=

# Public base URLs the backends put in links (uploaded images, Swagger). Defaults: http://localhost:<port>
# AUTH_PUBLIC_URL=http://localhost:3001
# REWARDS_PUBLIC_URL=http://localhost:3002
# CHATBOT_PUBLIC_URL=http://localhost:3003

# Where the backend repositories are, relative to this docker/ folder. Defaults: siblings of main-frontend.
# AUTH_SERVICE_DIR=../../auth-service-backend
# POINTS_SYSTEM_DIR=../../points-system-backend
# AI_CHATBOT_DIR=../../ai-chatbot-backend
